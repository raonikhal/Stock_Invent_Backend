generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}


model Shop {
  id                 Int                 @id @default(autoincrement())
  shopCode           String              @unique @map("shop_code") @db.VarChar(20)
  rtoCode            String              @map("rto_code") @db.VarChar(10)
  shopName           String              @map("shop_name") @db.VarChar(255)
  ownerName          String?             @map("owner_name") @db.VarChar(255)
  phone              String              @unique @db.VarChar(20)
  password           String              @db.VarChar(255)
  district           String?             @db.VarChar(100)
  state              String?             @db.VarChar(100)
  upiId              String?             @map("upi_id") @db.VarChar(100)
  isMasterBanned     Boolean             @default(false) @map("is_master_banned")
  banExpiresAt       DateTime?           @map("ban_expires_at")
  createdAt          DateTime            @default(now()) @map("created_at")

   // Password Reset Fields
  passwordResetOtp     String?        @map("password_reset_otp")
  passwordResetOtpExpiry DateTime?    @map("password_reset_otp_expiry")
  passwordResetToken   String?        @map("password_reset_token") @db.VarChar(255)
  
  // Relations
  users              User[]
  godowns            Godown[]
  shopInventory      ShopInventory[]
  shopLooseItems     ShopLooseItem[]
  sales              Sale[]
  customers          Customer[]
  creditTransactions CreditTransaction[]
  batches            ProductBatch[]
  transactions       Transaction[]
  notifications      Notification[]     // <-- YEH LINE ADD KAREIN

  @@map("shops")
}

model User {
  id                   Int            @id @default(autoincrement())
  shopId               Int            @map("shop_id")
  name                 String         @db.VarChar(255)
  email                String         @unique @db.VarChar(255)
  password             String         @db.VarChar(255)
  phone                String?        @unique @db.VarChar(20)
  role                 Role           @default(WORKER)
  securityPin          String?        @map("security_pin")
  pinResetOtp          String?        @map("pin_reset_otp")
  pinResetOtpExpiry    DateTime?      @map("pin_reset_otp_expiry")

  fcmToken             String?        @map("fcm_token") @db.VarChar(550)
  isSubscriptionActive Boolean        @default(false) @map("is_subscription_active")
  subscriptionEndAt    DateTime?      @map("subscription_end_at")
  razorpayPaymentId    String?        @map("razorpay_payment_id") @db.VarChar(100)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  shop                 Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "fk_users_shop_id")
  notifications        Notification[]

  @@index([shopId])
  @@map("users")
}


model Godown {
  id              Int               @id @default(autoincrement())
  shopId          Int               @map("shop_id")
  godownName      String            @map("godown_name") @db.VarChar(100)
  address         String?           @db.Text
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  godownInventory GodownInventory[]

  @@index([shopId])
  @@map("godowns")
}

model MasterProduct {
  id              Int               @id @default(autoincrement())
  barcode         String            @unique @db.VarChar(100)
  cartonCode      String?           @unique @map("carton_code") @db.VarChar(100)
  productName     String            @map("product_name") @db.VarChar(255)
  mrp             Decimal           @db.Decimal(10, 2)
  unitsPerCase    Int               @default(1) @map("units_per_case")
  netWeight       String?           @map("net_weight") @db.VarChar(50)
  imageUrl        String?           @map("image_url") @db.Text
  category        String?           @db.VarChar(100)
  createdAt       DateTime          @default(now()) @map("created_at")
  shopInventory   ShopInventory[]
  godownInventory GodownInventory[]
  saleItems       SaleItem[]
  batches         ProductBatch[]

  @@index([productName])
  @@map("master_products")
}

model ProductBatch {
  id              Int               @id @default(autoincrement())
  shopId          Int               @map("shop_id")
  productId       Int               @map("product_id")
  barcode         String?           @db.VarChar(100)
  productName     String?           @map("product_name") @db.VarChar(255)
  batchNumber     String            @map("batch_number") @db.VarChar(100)
  mrp             Decimal           @db.Decimal(10, 2)
  expiryDate      DateTime          @map("expiry_date") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at")
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         MasterProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopInventory   ShopInventory[]
  godownInventory GodownInventory[]
  saleItems       SaleItem[]

  @@unique([shopId, productId, batchNumber], name: "shop_product_batch_unique")
  @@index([shopId])
  @@index([productId])
  @@index([barcode])
  @@index([expiryDate])
  @@map("product_batches")
}

model ShopInventory {
  id           Int           @id @default(autoincrement())
  shopId       Int           @map("shop_id")
  productId    Int           @map("product_id")
  batchId      Int           @map("batch_id")
  barcode      String?       @db.VarChar(100)
  productName  String?       @map("product_name") @db.VarChar(255)
  quantity     Int           @default(0)
  sellingPrice Decimal       @map("selling_price") @db.Decimal(10, 2)
  discount     Decimal       @default(0.00) @db.Decimal(5, 2)
  reorderLevel Int?          @default(20) @map("reorder_level")
  sectionName  String?       @map("section_name") @db.VarChar(50)
  rackNumber   String?       @map("rack_number") @db.VarChar(50)
  updatedAt    DateTime      @updatedAt @map("updated_at")
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product      MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch        ProductBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId, batchId], name: "shop_product_batch_unique_inv")
  @@index([shopId])
  @@index([productId])
  @@index([barcode])
  @@index([batchId], map: "shop_inventory_batch_id_fkey")
  @@map("shop_inventory")
}

model ShopLooseItem {
  id            Int        @id @default(autoincrement())
  shopId        Int        @map("shop_id")
  customBarcode String     @map("custom_barcode") @db.VarChar(100)
  customName    String     @map("custom_name") @db.VarChar(255)
  category      String?    @db.VarChar(100)
  netWeight     String?    @map("net_weight") @db.VarChar(50)
  sellingPrice  Decimal    @map("selling_price") @db.Decimal(10, 2)
  quantity      Int        @default(0)
  expiryDate    DateTime?  @map("expiry_date")
  reorderLevel  Int        @default(5) @map("reorder_level")
  sectionName   String?    @map("section_name") @db.VarChar(50)
  rackNumber    String?    @map("rack_number") @db.VarChar(50)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  imageUrl      String?    @db.Text
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]

  @@unique([shopId, customBarcode], name: "shop_custom_barcode_unique")
  @@index([shopId])
  @@index([customName])
  @@map("shop_loose_items")
}

model GodownInventory {
  id          Int           @id @default(autoincrement())
  godownId    Int           @map("godown_id")
  productId   Int           @map("product_id")
  batchId     Int           @map("batch_id")
  barcode     String?       @db.VarChar(100)
  productName String?       @map("product_name") @db.VarChar(255)
  quantity    Int           @default(0)
  sectionName String?       @map("section_name") @db.VarChar(50)
  rackNumber  String?       @map("rack_number") @db.VarChar(50)
  godown      Godown        @relation(fields: [godownId], references: [id], onDelete: Cascade)
  product     MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       ProductBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([godownId])
  @@index([productId])
  @@index([barcode])
  @@index([batchId], map: "godown_inventory_batch_id_fkey")
  @@map("godown_inventory")
}

model Sale {
  id            Int                 @id @default(autoincrement())
  shopId        Int                 @map("shop_id")
  customerId    Int?                @map("customer_id")
  totalAmount   Decimal             @map("total_amount") @db.Decimal(10, 2)
  discount      Float?
  paymentMode   PaymentMode         @default(CASH) @map("payment_mode")
  customerPhone String?             @map("customer_phone") @db.VarChar(20)
  receiptUrl    String?             @map("receipt_url") @db.Text
  createdAt     DateTime            @default(now()) @map("created_at")
  shop          Shop                @relation(fields: [shopId], references: [id])
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleItems     SaleItem[]
  creditTxns    CreditTransaction[]

  @@index([shopId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id           Int            @id @default(autoincrement())
  saleId       Int            @map("sale_id")
  productId    Int?           @map("product_id")
  batchId      Int?           @map("batch_id")
  looseItemId  Int?           @map("loose_item_id")
  itemName     String         @map("item_name") @db.VarChar(255)
  quantity     Int
  pricePerUnit Decimal        @map("price_per_unit") @db.Decimal(10, 2)
  sale         Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      MasterProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  batch        ProductBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  looseItem    ShopLooseItem? @relation(fields: [looseItemId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([looseItemId])
  @@index([batchId])
  @@map("sale_items")
}

model Customer {
  id         Int                 @id @default(autoincrement())
  shopId     Int                 @map("shop_id")
  name       String?             @db.VarChar(255)
  phone      String              @db.VarChar(20)
  totalDue   Decimal             @default(0.00) @map("total_due") @db.Decimal(10, 2)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  shop       Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales      Sale[]
  creditTxns CreditTransaction[]

  @@unique([shopId, phone], name: "shop_customer_phone_unique")
  @@index([shopId])
  @@map("customers")
}

model CreditTransaction {
  id         Int           @id @default(autoincrement())
  shopId     Int           @map("shop_id")
  customerId Int           @map("customer_id")
  saleId     Int?          @map("sale_id")
  type       CreditTxnType
  amount     Decimal       @db.Decimal(10, 2)
  note       String?       @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at")
  shop       Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale       Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([customerId])
  @@index([saleId])
  @@map("credit_transactions")
}

model Transaction {
  id           String        @id @db.VarChar(100)
  shopId       Int           @map("shop_id")
  razorpayQrId String?       @map("razorpay_qr_id") @db.VarChar(100)
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  cartData     Json?         @map("cart_data")
  invoiceId    String?       @map("invoice_id") @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([razorpayQrId])
  @@map("transactions")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
}

enum Role {
  OWNER
  WORKER
}

enum CreditTxnType {
  DEBIT
  CREDIT
}


// In-App Notification Bell support
model Notification {
  id        Int              @id @default(autoincrement())
  shopId    Int              @map("shop_id")
  userId    Int?             @map("user_id")
  title     String           @db.VarChar(255)
  body      String           @db.Text
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([userId])
  @@index([shopId, isRead])
  @@map("notifications")
}


enum NotificationType {
  MARKETING
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRING_SOON
  EXPIRED
  DEAD_STOCK
  GENERAL
}